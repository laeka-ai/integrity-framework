{
  "_comment": [
    "EXAMPLE wiring for the 'builder' role: a write-heavy agent that mutates",
    "code, config and infrastructure. It carries the full mutation battery.",
    "Copy this file, replace $HARNESS_HOME with the absolute path where you",
    "cloned integrity-framework, and point your launcher at it.",
    "Every gate here is fail-open: a gate that crashes never blocks the flow.",
    "Every gate journals every execution to $HARNESS_GATE_STATS, which is what",
    "lets the sentinel prove a wired gate is actually alive."
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/shield-inject.py --agent builder"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/shield-reviewer.py --agent builder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/home-prefix-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/grep-quantifier-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/destructive-command-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/hook-retire-gate.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/interlock-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/settings-go-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/shell-false-success-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/destructive-dry-run-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/isolated-llm-measure-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/memory-verdict-gate.py"
          }
        ]
      }
    ]
  }
}
