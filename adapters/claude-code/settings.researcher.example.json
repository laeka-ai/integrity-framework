{
  "_comment": [
    "EXAMPLE wiring for the 'researcher' role: a read-heavy agent that reads",
    "widely and writes narrowly (reports, notes). It carries a scope perimeter",
    "and an output ceiling instead of the full mutation battery.",
    "Copy this file, replace $HARNESS_HOME with the absolute path where you",
    "cloned agent-controls, and set HARNESS_WRITE_SCOPE to this role's perimeter.",
    "Every gate here is fail-open and journals every execution."
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/shield-inject.py --agent researcher"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/home-prefix-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/grep-quantifier-gate.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/scope-write-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/memory-verdict-gate.py"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/workflow-gate.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/response-length-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HARNESS_HOME/adapters/claude-code/hooks/shield-reviewer.py --agent researcher"
          }
        ]
      }
    ]
  }
}
